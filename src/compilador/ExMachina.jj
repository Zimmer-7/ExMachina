options
{
  static = false;
}

PARSER_BEGIN(ExMachina)

package compilador;
import java.io.IOException;
import java.io.FileNotFoundException;
import java.io.Reader;
import javax.swing.tree.DefaultMutableTreeNode;

public class ExMachina
{
  // CONTADOR DE ERROS (Opcional, mas ajuda a saber se o código rodou limpo)
  private int errosSintaticos = 0;

  // Campo para receber o resultado da compilação (usado pela interface gráfica)
  private ResultadoCompilacao resultado;

  // Construtor extra usado pela interface gráfica
  public ExMachina(Reader r, ResultadoCompilacao res) {
    this(r);
    this.resultado = res;
  }

  // Registra o token reconhecido na lista (usado pela interface gráfica)
  private void reg(Token t, String tipo) {
    if (resultado != null) resultado.addToken(t.image, tipo);
  }

  // NOSSO AUXILIAR DE PÂNICO: Consome tokens até achar um dos tokens "seguros" passados por parâmetro
  public void pulaAte(int... tokensSeguros)
  {
    Token t;
    while (true)
    {
      t = getToken(1); // Olha o próximo token sem tirar da fila

      // Se for o fim do arquivo, para o pânico imediatamente
      if (t.kind == EOF) return;

      // Se o token atual for um dos tokens seguros que queremos, interrompe o pânico
      for (int tokenSeguro : tokensSeguros)
      {
        if (t.kind == tokenSeguro) return;
      }

      // Se não for seguro, joga fora e avança
      getNextToken();
    }
  }

  public static void main(String args [])
  {
    if (args.length < 1) {
        System.err.println("Uso: java compilador.ExMachina <arquivo>");
        System.exit(1);
    }

    try (Reader r = LerArquivo.abrir(args[0])) {
        ExMachina parser = new ExMachina(r);
        parser.inicio();
        System.out.println("Análise concluída com sucesso.");
    } catch (FileNotFoundException e) {
        System.err.println("Arquivo não encontrado: " + args[0]);
        System.exit(2);
    } catch (IOException e) {
        System.err.println("Erro de I/O: " + e.getMessage());
        System.exit(2);
    } catch (ParseException e) {
        System.err.println(MensagensErro.deSintaxe(e));
        System.exit(3);
    } catch (TokenMgrError e) {
        System.err.println(MensagensErro.deLexico(e));
        System.exit(3);
    }
  }

}

PARSER_END(ExMachina)

SKIP :
{
  " "
| "\r"
| "\t"
| "\n"
}

TOKEN : /* OPERATORS */
{
  < MAIS : "+" >
| < MENOS : "-" >
| < MULTIPLICA : "*" >
| < DIVIDE : "/" >
}

TOKEN :
{
  < MAIN : "MagnumOpus">
| < ABREBLOCO : "Aperta">
| < FECHABLOCO : "Clauderes">
| < ABREPARENT : "Aperi" >
| < FECHAPARENT : "Claude" >
| < FIM : "~">
| < TIPOINT : "totum">
| < TIPOFLOAT : "fracta">
| < TIPOSTRING : "verbum">
| < ATRIBUICAO : "memento">
| < SEPARADOR  : "," >
| < IF : "ceteris" >
| < ELSE : "paribus" >
| < IGUAL : "idem" >
| < MAIOR : "maximus" >
| < MENOR : "minus" >
| < MAIORIGUAL : "aequalis" >
| < MENORIGUAL : "iunior" >
| < DIFERENTE : "diversus">
| < LOOPFOR : "iterabilis" >
| < LOOPWHILE : "dum" >
| < ABREVETOR : "Catena">
| < FECHAVETOR : "Connexa">
| < BREAK: "mori">
| < CONTINUE: "proximus">
| < RETURN: "reditus">
| < INCREMENTO : "Auctus" >
}

TOKEN :
{
  < CONSTANTE : < DIGITO > ((< DIGITO >)* | < REAL >) >
| < DIGITO : [ "0"-"9" ] >
| < REAL : "."(< DIGITO >)+ >
| < ID: (<CARACTERE >)+>
| < CARACTERE : ["a" - "z"] | ["A" - "Z"]>
| < CADEIA : "\"" (<CARACTERE> | <DIGITO> | " ")* "\"" >
}

DefaultMutableTreeNode inicio() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("inicio");
  DefaultMutableTreeNode filho; }
{
  (
    try {
      filho=declaracao() { no.add(filho); }
    } catch (ParseException e) {
      errosSintaticos++;
      String msg = MensagensErro.deSintaxe(e);
      System.out.println(msg);
      if (resultado != null) resultado.erros.add(msg);
      pulaAte(TIPOINT, TIPOFLOAT, TIPOSTRING, MAIN);
    }
  )*

  < MAIN > filho=bloco() { no.add(new DefaultMutableTreeNode("MagnumOpus")); no.add(filho); }

  (
    try {
      filho=declaracao() { no.add(filho); }
    } catch (ParseException e) {
      errosSintaticos++;
      String msg = MensagensErro.deSintaxe(e);
      System.out.println(msg);
      if (resultado != null) resultado.erros.add(msg);
      pulaAte(TIPOINT, TIPOFLOAT, TIPOSTRING, EOF);
    }
  )*
  { if (resultado != null) resultado.raizArvore = no; return no; }
|
  < EOF > { if (resultado != null) resultado.raizArvore = no; return no; }
}

DefaultMutableTreeNode bloco() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("bloco");
  DefaultMutableTreeNode filho; }
{
  < ABREBLOCO >
  (
    // 1. O LOOKAHEAD FORÇA o parser a entrar no loop para qualquer token,
    // garantindo que os erros caiam DENTRO do try-catch.
    LOOKAHEAD({ getToken(1).kind != FECHABLOCO && getToken(1).kind != EOF })
    
    try {
      ( filho=declaracao()    { no.add(filho); }
      | filho=condicional()   { no.add(filho); }
      | filho=enquanto()      { no.add(filho); }
      | filho=para()          { no.add(filho); }
      | filho=controladores() { no.add(filho); }
      | filho=chamada()       { no.add(filho); }
      | filho=incremento()    { no.add(filho); }
      )
    } catch (ParseException e) {
      errosSintaticos++;
      String msg = MensagensErro.deSintaxe(e);
      System.out.println(msg);
      if (resultado != null) resultado.erros.add(msg);
      
      // 2. ADICIONA UM NÓ DE ERRO NA AST (Opcional, mas muito útil)
      no.add(new DefaultMutableTreeNode("Erro: " + e.currentToken.next.image));
      
      pulaAte(FIM, FECHABLOCO);
      if (getToken(1).kind == FIM) {
        getNextToken();
      }
    }
  )* < FECHABLOCO >
  { return no; }
}

DefaultMutableTreeNode declaracao() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("declaracao");
  DefaultMutableTreeNode filho; Token t; }
{
  filho=tipo() { no.add(filho); }
  t=< ID > { reg(t, "ID"); no.add(new DefaultMutableTreeNode("id: " + t.image)); }
  ( filho=declaraFuncao() | filho=declaraVariavel() ) { no.add(filho); }
  { return no; }
}

DefaultMutableTreeNode declaraFuncao() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("declaraFuncao");
  DefaultMutableTreeNode filho; Token t; }
{
  < ABREPARENT >
  filho=tipo() { no.add(filho); }
  t=< ID > { no.add(new DefaultMutableTreeNode("id: " + t.image)); }
  ( < SEPARADOR > filho=tipo() { no.add(filho); } t=< ID > { no.add(new DefaultMutableTreeNode("id: " + t.image)); } )*
  < FECHAPARENT >
  filho=bloco() { no.add(filho); }
  { return no; }
}

DefaultMutableTreeNode declaraVariavel() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("declaraVariavel");
  DefaultMutableTreeNode filho; Token t; }
{
  (filho=vetorTamanho() { no.add(filho); })?
  (< SEPARADOR > t=< ID > { no.add(new DefaultMutableTreeNode("id: " + t.image)); })*
  (filho=atribuicao() { no.add(filho); })?
  < FIM >
  { return no; }
}

DefaultMutableTreeNode chamada() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("chamada");
  DefaultMutableTreeNode filho; Token t; }
{
  t=< ID > { reg(t, "ID"); no.add(new DefaultMutableTreeNode("id: " + t.image)); }
  ( filho=chamadaFuncao() | filho=chamadaVariavel() | filho=incremento() ) { no.add(filho); }
  { return no; }
}

DefaultMutableTreeNode chamadaFuncao() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("chamadaFuncao");
  DefaultMutableTreeNode filho; }
{
  < ABREPARENT >
  (filho=expressao() { no.add(filho); } (< SEPARADOR > filho=expressao() { no.add(filho); })*)?
  < FECHAPARENT > < FIM >
  { return no; }
}

DefaultMutableTreeNode chamadaVariavel() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("chamadaVariavel");
  DefaultMutableTreeNode filho; }
{
  (filho=atribuicao() { no.add(filho); })? < FIM >
  { return no; }
}

DefaultMutableTreeNode vetorTamanho() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("vetorTamanho");
  DefaultMutableTreeNode filho; Token t; }
{
  < ABREVETOR >
  ( t=< CONSTANTE > { no.add(new DefaultMutableTreeNode(t.image)); } filho=semiExpressao() { no.add(filho); }
  | t=< ID >        { no.add(new DefaultMutableTreeNode(t.image)); } filho=semiExpressao() { no.add(filho); }
  )?
  < FECHAVETOR >
  { return no; }
}

DefaultMutableTreeNode vetorCheio() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("vetorCheio");
  DefaultMutableTreeNode filho; }
{
  < ABREVETOR >
  filho=valor() { no.add(filho); }
  (< SEPARADOR > filho=valor() { no.add(filho); })*
  < FECHAVETOR >
  { return no; }
}

DefaultMutableTreeNode valor() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("valor"); Token t; }
{
  ( t=< CONSTANTE > { reg(t, "CONSTANTE"); } | t=< CADEIA > { reg(t, "CADEIA"); } )
  { no.add(new DefaultMutableTreeNode(t.image)); return no; }
}

DefaultMutableTreeNode atribuicao() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("atribuicao");
  DefaultMutableTreeNode filho; }
{
  < ATRIBUICAO >
  (filho=valores() | filho=vetorCheio()) { no.add(filho); }
  (< SEPARADOR > filho=valores() { no.add(filho); })*
  { return no; }
}

DefaultMutableTreeNode valores() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("valores");
  DefaultMutableTreeNode filho; Token t; }
{
  ( t=< CADEIA > { no.add(new DefaultMutableTreeNode(t.image)); }
  | filho=chamadaFuncao() { no.add(filho); } filho=semiExpressao() { no.add(filho); }
  | filho=expressao() { no.add(filho); }
  )
  { return no; }
}

DefaultMutableTreeNode controladores() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("controladores");
  DefaultMutableTreeNode filho; Token t; }
{
  ( t=< BREAK >    { reg(t, "BREAK");    no.add(new DefaultMutableTreeNode(t.image)); }
  | t=< CONTINUE > { reg(t, "CONTINUE"); no.add(new DefaultMutableTreeNode(t.image)); }
  | t=< RETURN >   { reg(t, "RETURN");   no.add(new DefaultMutableTreeNode(t.image)); } filho=expressao() { no.add(filho); }
  ) < FIM >
  { return no; }
}

DefaultMutableTreeNode tipo() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("tipo"); Token t; }
{
  ( t=< TIPOINT > { reg(t, "TIPOINT"); } | t=< TIPOFLOAT > { reg(t, "TIPOFLOAT"); } | t=< TIPOSTRING > { reg(t, "TIPOSTRING"); } )
  { no.add(new DefaultMutableTreeNode(t.image)); return no; }
}

DefaultMutableTreeNode expressao() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("expressao");
  DefaultMutableTreeNode filho; Token t; }
{
  filho=termo() { no.add(filho); }
  ( ( t=< MAIS > | t=< MENOS > )
    { no.add(new DefaultMutableTreeNode(t.image)); }
    filho=termo() { no.add(filho); }
  )*
  { return no; }
}

DefaultMutableTreeNode semiExpressao() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("semiExpressao");
  DefaultMutableTreeNode filho; Token t; }
{
  ( ( t=< MAIS > | t=< MENOS > )
    { no.add(new DefaultMutableTreeNode(t.image)); }
    filho=termo() { no.add(filho); }
  )*
  { return no; }
}

DefaultMutableTreeNode termo() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("termo");
  DefaultMutableTreeNode filho; Token t; }
{
  filho=unario() { no.add(filho); }
  ( ( t=< MULTIPLICA > | t=< DIVIDE > )
    { no.add(new DefaultMutableTreeNode(t.image)); }
    filho=unario() { no.add(filho); }
  )*
  { return no; }
}

DefaultMutableTreeNode unario() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("unario");
  DefaultMutableTreeNode filho; }
{
  ( < MENOS > { no.add(new DefaultMutableTreeNode("-")); } filho=elemento() { no.add(filho); }
  | filho=elemento() { no.add(filho); }
  )
  { return no; }
}

DefaultMutableTreeNode elemento() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("elemento");
  DefaultMutableTreeNode filho; Token t; }
{
  ( t=< CONSTANTE > { reg(t, "CONSTANTE"); no.add(new DefaultMutableTreeNode(t.image)); }
  | t=< ID >        { reg(t, "ID");        no.add(new DefaultMutableTreeNode(t.image)); }
  | "(" filho=expressao() { no.add(filho); } ")"
  )
  { return no; }
}

DefaultMutableTreeNode operadores() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("operador"); Token t; }
{
  ( t=< IGUAL >      { reg(t, "IGUAL");      }
  | t=< MAIOR >      { reg(t, "MAIOR");      }
  | t=< MENOR >      { reg(t, "MENOR");      }
  | t=< MAIORIGUAL > { reg(t, "MAIORIGUAL"); }
  | t=< MENORIGUAL > { reg(t, "MENORIGUAL"); }
  | t=< DIFERENTE >  { reg(t, "DIFERENTE");  }
  )
  { no.add(new DefaultMutableTreeNode(t.image)); return no; }
}

DefaultMutableTreeNode condicional() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("condicional");
  DefaultMutableTreeNode filho; }
{
  < IF > < ABREPARENT > filho=condicao() { no.add(filho); } < FECHAPARENT >
  filho=bloco() { no.add(filho); }
  ( < ELSE > filho=bloco() { no.add(new DefaultMutableTreeNode("else")); no.add(filho); } )?
  { return no; }
}

DefaultMutableTreeNode condicao() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("condicao");
  DefaultMutableTreeNode filho; Token t; }
{
  t=< ID > { reg(t, "ID"); no.add(new DefaultMutableTreeNode(t.image)); }
  filho=operadores() { no.add(filho); }
  ( t=< ID > { reg(t, "ID"); } | t=< CONSTANTE > { reg(t, "CONSTANTE"); } ) { no.add(new DefaultMutableTreeNode(t.image)); }
  { return no; }
}

DefaultMutableTreeNode para() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("para");
  DefaultMutableTreeNode filho; Token t; }
{
  < LOOPFOR > < ABREPARENT >
  (filho=declaracao() { no.add(filho); })?
  filho=condicao() { no.add(filho); } < FIM >
  ( t=< ID > { no.add(new DefaultMutableTreeNode(t.image)); } filho=incremento() { no.add(filho); }
  | filho=declaraVariavel() { no.add(filho); }
  )?
  < FECHAPARENT >
  filho=bloco() { no.add(filho); }
  { return no; }
}

DefaultMutableTreeNode enquanto() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("enquanto");
  DefaultMutableTreeNode filho; }
{
  < LOOPWHILE > < ABREPARENT >
  filho=condicao() { no.add(filho); }
  < FECHAPARENT >
  filho=bloco() { no.add(filho); }
  { return no; }
}

DefaultMutableTreeNode incremento() :
{ DefaultMutableTreeNode no = new DefaultMutableTreeNode("incremento");
  Token t; }
{
  < INCREMENTO >
  ( < SEPARADOR > t=< ID > { no.add(new DefaultMutableTreeNode(t.image)); } < INCREMENTO > )*
  < FIM >
  { return no; }
}
