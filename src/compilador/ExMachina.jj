options
{
  static = true;
}

PARSER_BEGIN(ExMachina)
package compilador;

public class ExMachina
{
  public static void main(String args []) throws ParseException
  {
    ExMachina parser = new ExMachina(System.in);
    while (true)
    {
      System.out.println("Lendo o input padrao");
      System.out.print("Insira uma declaracao de variavel:\n");
      try
      {
        switch (ExMachina.inicio())
        {
          case 0 : 
          System.out.println("OK.");
          break;
          case 1 : 
          System.out.println("Goodbye.");
          break;
          default : 
          break;
        }
      }
      catch (Exception e)
      {
        System.out.println("NOK.");
        System.out.println(e.getMessage());
        ExMachina.ReInit(System.in);
      }
      catch (Error e)
      {
        System.out.println("Oops.");
        System.out.println(e.getMessage());
        break;
      }
    }
  }
}

PARSER_END(ExMachina)

SKIP :
{
  " "
| "\r"
| "\t"
| "\n"
}

TOKEN : /* OPERATORS */
{
  < MAIS : "+" >
| < MENOS : "-" >
| < MULTIPLICA : "*" >
| < DIVIDE : "/" >
}

TOKEN :
{
  < MAIN : "MagnumOpus">
| < ABREBLOCO : "Aperta">
| < FECHABLOCO : "Clauderes">
| < ABREPARENT : "Aperi" >
| < FECHAPARENT : "Claude" >
| < FIM : "~">
| < TIPOINT : "totum">
| < TIPOFLOAT : "fracta">
| < TIPOSTRING : "verbum">
| < ATRIBUICAO : "memento">
| < SEPARADOR  : "," >
| < IF : "ceteris" >
| < ELSE : "paribus" >
| < IGUAL : "idem" >
| < MAIOR : ">" >
| < MENOR : "<" >
| < MAIORIGUAL : ">=" >
| < MENORIGUAL : "<=" >
| < LOOPFOR : "iterabilis" >
| < LOOPWHILE : "dum" >
| < ABREVETOR : "Catena">
| < FECHAVETOR : "Connexa">

}

TOKEN :
{
  < CONSTANTE : (< DIGITO >)+ >
| < DIGITO : [ "0"-"9" ] >
| < REAL : < CONSTANTE >"."< CONSTANTE > >
| < ID: (<CARACTERE >)+>
| < CARACTERE : ["a" - "z"] | ["A" - "Z"]>
| < CADEIA : "\"" (<CARACTERE> | <DIGITO> | " ")* "\"" >
}

int inicio() :
{ }
{	 < MAIN > bloco()
	
	{
	  return 0;
	}

| < EOF> { return 1; }
}

void bloco() :
{ }
{
	< ABREBLOCO > (declaracao() <FIM> | condicional() | enquanto() | para())* < FECHABLOCO>
}

void declaracao() :
{ }
{
	(< TIPOINT >(vetorTamanho())? < ID > (atribuicaoInt())? |
	 < TIPOFLOAT >(vetorTamanho())? < ID > (atribuicaoFloat())? |
	 < TIPOSTRING >(vetorTamanho())? < ID > (atribuicaoString())?) 
}

void vetorTamanho() :
{}
{
  < ABREVETOR > (< CONSTANTE >)? < FECHAVETOR >
}

void vetorCheio() :
{}
{
  < ABREVETOR > valor() (< SEPARADOR > valor())* < FECHAVETOR >
}

void valor() :
{}
{
  < CONSTANTE > | < CADEIA > | < REAL >
}

void declaracaoMultipla() :
{ }
{
	declaracao() ( < SEPARADOR > declaracao())*
}

void atribuicaoString() :
{}
{
	< ATRIBUICAO> (<CADEIA> | vetorCheio())
}

void atribuicaoInt() :
{}
{
	< ATRIBUICAO> (<CONSTANTE> semiExpressao() | vetorCheio())
}

void atribuicaoFloat() :
{}
{
	< ATRIBUICAO> (< REAL > | expressao() | vetorCheio())
}

void tipo() :
{}
{
	< TIPOINT > | < TIPOFLOAT> | < TIPOSTRING> 
}

void expressao() :
{}
{
	termo()((< MAIS > | < MENOS >) termo() )*
}

void semiExpressao() :
{}
{
	((< MAIS > | < MENOS >) termo() )*
}

void termo() :
{}
{
	unario()((< MULTIPLICA > | < DIVIDE >)unario())*
}

void unario() :
{}
{
	< MENOS > elemento() | elemento()
}

void elemento() :
{}
{
	< CONSTANTE >
| 	<ABREPARENT > expressao() < FECHAPARENT >
}

void operadores() :
{}
{
	<IGUAL > | < MAIOR > | < MENOR > | < MAIORIGUAL > | < MENORIGUAL >
}

void condicional() :
{}
{
	< IF > <ABREPARENT > condicao() < FECHAPARENT > bloco() ( < ELSE > bloco())?
}

void condicao() :
{}
{
	< ID >  operadores() (< ID > | < CONSTANTE >)

}

void para() :
{}
{
	< LOOPFOR > <ABREPARENT > (declaracao())? < FIM > condicao() < FIM > (expressao())? < FECHAPARENT > bloco()
}

void enquanto() :
{}
{
	< LOOPWHILE > <ABREPARENT > condicao() < FECHAPARENT > bloco() ( < ELSE > bloco())?
}
  
