options
{
  static = true;
}

PARSER_BEGIN(ExMachina)
package compilador;

public class ExMachina
{
  public static void main(String args []) throws ParseException
  {
    ExMachina parser = new ExMachina(System.in);
    while (true)
    {
      System.out.print("Codifique em Latim:\n");
      try
      {
        switch (ExMachina.inicio())
        {
          case 0 : 
          System.out.println("Re vera bonum est.");
          break;
          case 1 : 
          System.out.println("Goodbye.");
          break;
          default : 
          break;
        }
      }
      catch (Exception e)
      {
        System.out.println("Defectum");
        System.out.println(e.getMessage());
        ExMachina.ReInit(System.in);
      }
      catch (Error e)
      {
        System.out.println("Oops.");
        System.out.println(e.getMessage());
        break;
      }
    }
  }
}

PARSER_END(ExMachina)

SKIP :
{
  " "
| "\r"
| "\t"
| "\n"
}

TOKEN : /* OPERATORS */
{
  < MAIS : "+" >
| < MENOS : "-" >
| < MULTIPLICA : "*" >
| < DIVIDE : "/" >
}

TOKEN :
{
  < MAIN : "MagnumOpus">
| < ABREBLOCO : "Aperta">
| < FECHABLOCO : "Clauderes">
| < ABREPARENT : "Aperi" >
| < FECHAPARENT : "Claude" >
| < FIM : "~">
| < TIPOINT : "totum">
| < TIPOFLOAT : "fracta">
| < TIPOSTRING : "verbum">
| < ATRIBUICAO : "memento">
| < SEPARADOR  : "," >
| < IF : "ceteris" >
| < ELSE : "paribus" >
| < IGUAL : "idem" >
| < MAIOR : "maximus" >
| < MENOR : "minus" >
| < MAIORIGUAL : "aequalis" >
| < MENORIGUAL : "iunior" >
| < DIFERENTE : "diversus">
| < LOOPFOR : "iterabilis" >
| < LOOPWHILE : "dum" >
| < ABREVETOR : "Catena">
| < FECHAVETOR : "Connexa">
| < BREAK: "mori">
| < CONTINUE: "proximus">
| < RETURN: "reditus">
| < INCREMENTO : "Auctus" >

}

TOKEN :
{
  < CONSTANTE : (< DIGITO >)+ >
| < DIGITO : [ "0"-"9" ] >
| < REAL : < CONSTANTE >"."< CONSTANTE > >
| < ID: (<CARACTERE >)+>
| < CARACTERE : ["a" - "z"] | ["A" - "Z"]>
| < CADEIA : "\"" (<CARACTERE> | <DIGITO> | " ")* "\"" >
}

int inicio() :
{ }
{
  	(declaracao())*	 < MAIN > bloco()
	(declaracao())*
	"."
	{
	  return 0;
	}

| < EOF > { return 1; }
}

void declaracao() :
{ }
{
	tipo() < ID > ( declaraFuncao() | declaraVariavel())
}

void declaraFuncao() :
{ }
{
  (< ABREPARENT >tipo() < ID >(< SEPARADOR > tipo() < ID >)*< FECHAPARENT >) bloco()
}

void declaraVariavel() :
{ }
{
  (vetorTamanho())?(< SEPARADOR > < ID > )* (atribuicao())? < FIM >
}

void chamada() :
{ }
{
  <ID> (chamadaFuncao() | chamadaVariavel() | incremento())
}

void chamadaFuncao() :
{ }
{
  < ABREPARENT> (expressao() (< SEPARADOR > expressao())*)?< FECHAPARENT > < FIM >
}

void chamadaVariavel() :
{ }
{
  (atribuicao())? < FIM >
}

void bloco() :
{ }
{
	< ABREBLOCO > (declaracao() | condicional() | enquanto() | para() | controladores() | chamada() | incremento())* < FECHABLOCO >
}

void vetorTamanho() :
{}
{
  < ABREVETOR > (< CONSTANTE > semiExpressao() | < ID > semiExpressao())? < FECHAVETOR >
}

void vetorCheio() :
{}
{
  < ABREVETOR > valor() (< SEPARADOR > valor())* < FECHAVETOR >
}

void valor() :
{}
{
  < CONSTANTE > | < CADEIA > | < REAL >
}

void atribuicao() :
{}
{
	< ATRIBUICAO > (valores() |  vetorCheio()) (< SEPARADOR > valores())*
}

void valores() :
{}
{
  < CADEIA >
| < CONSTANTE > semiExpressao()
| < REAL > semiExpressao()
| chamadaFuncao() semiExpressao()
| < ID > semiExpressao()
}

void controladores() :
{}
{
  ( <BREAK > | < CONTINUE> | <RETURN > expressao()) < FIM>
}

void tipo() :
{}
{
	< TIPOINT > | < TIPOFLOAT> | < TIPOSTRING> 
}

void expressao() :
{}
{
	termo()((< MAIS > | < MENOS >) termo() )*
}

void semiExpressao() :
{}
{
	((< MAIS > | < MENOS > | < MULTIPLICA > | < DIVIDE >) termo())*
}

void termo() :
{}
{
	unario()((< MULTIPLICA > | < DIVIDE >)unario())*
}

void unario() :
{}
{
	< MENOS > elemento() | elemento()
}

void elemento() :
{}
{
	< CONSTANTE >
| 	< ID >
|   < REAL >
|   < ABREPARENT > expressao() < FECHAPARENT >
}

void operadores() :
{}
{
	<IGUAL > | < MAIOR > | < MENOR > | < MAIORIGUAL > | < MENORIGUAL > | < DIFERENTE >
}

void condicional() :
{}
{
	< IF > <ABREPARENT > condicao() < FECHAPARENT > bloco() ( < ELSE > bloco())?
}

void condicao() :
{}
{
	< ID >  operadores() (< ID > | < CONSTANTE >)

}

void para() :
{}
{
	< LOOPFOR > <ABREPARENT > (declaracao())? condicao() < FIM > ( < ID > incremento() | declaraVariavel())? < FECHAPARENT > bloco()
}

void enquanto() :
{}
{
	< LOOPWHILE > <ABREPARENT > condicao() < FECHAPARENT > bloco()
}

void incremento():
{}
{
    <INCREMENTO > ( < SEPARADOR > <ID > <INCREMENTO >)* < FIM > 
}



  
  
