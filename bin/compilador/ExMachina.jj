options
{
  static = true;
}

PARSER_BEGIN(ExMachina)
package compilador;

public class ExMachina
{
  public static void main(String args []) throws ParseException
  {
    ExMachina parser = new ExMachina(System.in);
    while (true)
    {
      System.out.println("Lendo o input padrao");
      System.out.print("Insira uma declaracao de variavel:\n");
      try
      {
        switch (ExMachina.inicio())
        {
          case 0 : 
          System.out.println("OK.");
          break;
          case 1 : 
          System.out.println("Goodbye.");
          break;
          default : 
          break;
        }
      }
      catch (Exception e)
      {
        System.out.println("NOK.");
        System.out.println(e.getMessage());
        ExMachina.ReInit(System.in);
      }
      catch (Error e)
      {
        System.out.println("Oops.");
        System.out.println(e.getMessage());
        break;
      }
    }
  }
}

PARSER_END(ExMachina)

SKIP :
{
  " "
| "\r"
| "\t"
| "\n"
}

TOKEN : /* OPERATORS */
{
  < MAIS : "+" >
| < MENOS : "-" >
| < MULTIPLICA : "*" >
| < DIVIDE : "/" >
}

TOKEN :
{
  < MAIN : "MagnumOpus">
| < ABREBLOCO : "Aperta">
| < FECHABLOCO : "Clauderes">
| < FIM : "~">
| < TIPOINT : "totum">
| < TIPOFLOAT : "fracta">
| < TIPOSTRING : "verbum">
| < ATRIBUICAO : "=">

}

TOKEN :
{
  < CONSTANTE : (< DIGITO >)+ >
| < DIGITO : [ "0"-"9" ] >
| < ID: (<CARACTERE >)+>
| < CARACTERE : ["a" - "z"] | ["A" - "Z"]>
| < CADEIA : "\"" (<CARACTERE> | <DIGITO> | " ")* "\"" >
}

int inicio() :
{ }
{	 < MAIN> bloco()
	
	{
	  return 0;
	}

| < EOF> { return 1; }
}

void bloco() :
{ }
{
  < ABREBLOCO>(declaracao())* < FECHABLOCO>
}

void declaracao() :
{ }
{
  tipo() <ID > atribuicao() <FIM>
}

void atribuicao() :
{}
{
  < ATRIBUICAO> (expressao() | <CADEIA>)
}

void tipo() :
{}
{
  <TIPOINT > | < TIPOFLOAT> | < TIPOSTRING> 
}


void expressao() :
{}
{
  termo()((< MAIS > | < MENOS >) termo() )*
}

void termo() :
{}
{
  unario()((< MULTIPLICA > | < DIVIDE >)unario())*
}

void unario() :
{}
{
  < MENOS > elemento() | elemento()
}

void elemento() :
{}
{
  < CONSTANTE >
| "(" expressao() ")"
}
